# Copy to .env (never commit .env). Defaults match docker-compose.yml.
# The API validates these variables on startup (apps/api/src/config).

# NODE_ENV is intentionally not set here: Nx loads this file into every task,
# so it would leak into the web production build. The API defaults to
# development; deployed environments set NODE_ENV=production themselves.

# Port the API listens on. Defaults to 3000.
PORT=3000

# PostgreSQL connection string (required).
# Local: the docker compose service. Production: Neon (with sslmode=require).
DATABASE_URL=postgres://nutri:nutri@localhost:5432/nutri

# Absolute path to the built web app (apps/web/dist). Required in production,
# where the API also serves the SPA. Unused in development (Vite serves it).
# WEB_DIST_DIR=/app/apps/web/dist

# Transactional email. Required in production; in development they default
# to Mailpit (docker compose) and the Vite dev server, so leave them unset.
# SMTP server with credentials: smtps:// for implicit TLS (port 465), smtp://
# for STARTTLS (required in production). Production: Resend,
# smtps://resend:<API key>@smtp.resend.com:465
# SMTP_URL=smtp://localhost:1025
# Sender of every email.
# MAIL_FROM=Mi consulta <no-reply@localhost>
# Public origin of the app, without a trailing slash: links in emails use it.
# APP_ORIGIN=http://localhost:4200
