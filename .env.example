# Copy to .env (never commit .env). Defaults match docker-compose.yml.
# The API validates these variables on startup (apps/api/src/config).

# development | test | production. Defaults to development.
# The TEMPORARY development clinic guard only works in development.
NODE_ENV=development

# Port the API listens on. Defaults to 3000.
PORT=3000

# PostgreSQL connection string (required).
# Local: the docker compose service. Production: Neon (with sslmode=require).
DATABASE_URL=postgres://nutri:nutri@localhost:5432/nutri

# Absolute path to the built web app (apps/web/dist). Required in production,
# where the API also serves the SPA. Unused in development (Vite serves it).
# WEB_DIST_DIR=/app/apps/web/dist
